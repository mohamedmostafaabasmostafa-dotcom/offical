
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/khatmati",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/khatmati",
      "destination": "https://khatmati1.blogspot.com/"
    },
    {
      "source": "/khatmati/",
      "destination": "https://khatmati1.blogspot.com/"
    },
    {
      "source": "/khatmati/:path*",
      "destination": "https://khatmati1.blogspot.com/:path*"
    },
    {
      "source": "/lamma",
      "destination": "https://lamma-app.blogspot.com/"
    },
    {
      "source": "/lamma/",
      "destination": "https://lamma-app.blogspot.com/"
    },
    {
      "source": "/lamma/:path*",
      "destination": "https://lamma-app.blogspot.com/:path*"
    },
    {
      "source": "/ebsim",
      "destination": "https://ebsim.blogspot.com/"
    },
    {
      "source": "/ebsim/",
      "destination": "https://ebsim.blogspot.com/"
    },
    {
      "source": "/ebsim/:path*",
      "destination": "https://ebsim.blogspot.com/:path*"
    }
  ]
}
